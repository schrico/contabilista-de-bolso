# Copia este ficheiro para .env (que está fora do git) e preenche os valores localmente.
# Nunca escrevas valores neste ficheiro: ele é versionado.

# Base de dados (Postgres com pgvector). Em local: Postgres em Docker; na Azure: via Tailscale (D16).
DATABASE_URL=

# Fornecedores de modelos, todos através do LiteLLM (D14)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama local, por exemplo o endereço do servidor na tua máquina
OLLAMA_API_BASE=

# Langfuse Cloud, região UE (D9)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Tailscale: chave efémera com a tag tag:app (só na Azure)
TS_AUTHKEY=

# Chaos monkey: desligado por defeito; só liga com CHAOS=1 (D13)
CHAOS=
